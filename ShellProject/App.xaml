<Application x:Class="PaintClone.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The active theme. Index [0] of this list is swapped at runtime by
                     Services/ThemeManager.cs to switch Dark <-> Light - every color below is
                     referenced via DynamicResource specifically so that swap re-paints the whole
                     app (including already-open dialogs) instead of only new windows. -->
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!-- ===================================================================
             Base controls
             =================================================================== -->
        <Style TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource XpFace}"/>
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource XpBorder}"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <!-- Tooltips need an explicit theme. Left alone they keep WPF's default pale background,
             while their text - a bare string, which WPF wraps in a TextBlock - picks up the
             implicit TextBlock style above and comes out in the theme's light foreground colour.
             In the dark theme that is nearly-white text on a nearly-white bubble. Styling the
             ToolTip itself sets both halves together so they can't drift apart again. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource XpFaceDark}"/>
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource XpBorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <!-- TextElement.Foreground carries the colour down to the TextBlock WPF
                                 generates for a plain-string tooltip, which is the case that was
                                 actually broken. -->
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="{DynamicResource XpMenuBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Top-level menu-bar entries (File, Edit, View, ...) get their own, much simpler
             template: just a header and a dropdown Popup, sized to its text like a normal Windows
             menu bar. The full template below (checkmark gutter, InputGestureText column, submenu
             arrow) is for entries *inside* a dropdown, where that gutter is meaningful - reusing it
             for the menu bar itself was the bug: every top-level item silently carried an extra
             ~32px of checkmark/arrow columns it never used, so "File" and "Colors" rendered at
             the same bloated width instead of sizing to their own text. -->
        <ControlTemplate x:Key="TopLevelMenuItemTemplate" TargetType="MenuItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0" SnapsToDevicePixels="True">
                <Grid>
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="{TemplateBinding Padding}"/>
                    <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}"
                           AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border Background="{DynamicResource XpFaceDark}" BorderBrush="{DynamicResource PsAccent}"
                                BorderThickness="1" Padding="1">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PsHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource PsTextDim}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0" SnapsToDevicePixels="True">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="14"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="CheckMark" Grid.Column="0" Width="9" Height="7" Stretch="Fill"
                                      Data="M0,3 L3,6 L9,0" Stroke="{DynamicResource PsAccent}" StrokeThickness="1.6"
                                      Visibility="Collapsed" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                   VerticalAlignment="Center" Margin="4,0"/>
                                <TextBlock x:Name="IGT" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                           Foreground="{DynamicResource PsTextDim}" Margin="16,0,4,0" VerticalAlignment="Center"/>
                                <Path x:Name="Arrow" Grid.Column="3" Width="4" Height="8" Stretch="Fill"
                                      Data="M0,0 L4,4 L0,8 Z" Fill="{DynamicResource PsText}"
                                      Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                    <Border Background="{DynamicResource XpFaceDark}" BorderBrush="{DynamicResource PsAccent}"
                                            BorderThickness="1" Padding="1">
                                        <StackPanel IsItemsHost="True"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PsHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource PsTextDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Swap to the plain, content-sized template for anything sitting directly on the
                     menu bar - both entries with a dropdown (TopLevelHeader, e.g. "File") and any
                     without one (TopLevelItem, e.g. "Plugins" before any plugin is loaded into it). -->
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource TopLevelMenuItemTemplate}"/>
                    <Setter Property="Padding" Value="8,4"/>
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Template" Value="{StaticResource TopLevelMenuItemTemplate}"/>
                    <Setter Property="Padding" Value="8,4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="{DynamicResource XpMenuBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PsTextDim}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="StatusBarItem">
            <Setter Property="Foreground" Value="{DynamicResource PsTextDim}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource XpFaceDark}"/>
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource XpBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PsHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PsAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PsAccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsDefaulted" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PsAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource PsTextDim}"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="14" Height="14" Background="{DynamicResource XpFaceDark}"
                                    BorderBrush="{DynamicResource XpBorderLight}" BorderThickness="1" VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M1,4 L4,7.5 L10,1" Stroke="{DynamicResource PsAccent}"
                                      StrokeThickness="2" Visibility="Collapsed" Margin="1"/>
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PsAccent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PsAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Dot" Width="14" Height="14" CornerRadius="7" Background="{DynamicResource XpFaceDark}"
                                    BorderBrush="{DynamicResource XpBorderLight}" BorderThickness="1" VerticalAlignment="Center">
                                <Ellipse x:Name="Fill" Width="6" Height="6" Fill="{DynamicResource PsAccent}" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fill" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource PsAccent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource PsAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource XpFaceDark}"/>
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PsText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource XpBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource PsAccentSoft}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PsAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource XpFaceDark}"/>
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource XpBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource XpFaceDark}" BorderBrush="{DynamicResource XpBorder}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="18"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource PsText}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                               ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                               Margin="6,3,20,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <!-- Font is pinned rather than inherited. An editable ComboBox's edit
                                 box otherwise picks up whatever the ComboBox's items carry, and a
                                 font picker whose rows are each drawn in the font they name made
                                 the typed text render at a few pixels tall - unreadable. -->
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Background="Transparent"
                                     Foreground="{DynamicResource PsText}" Focusable="True"
                                     FontFamily="Segoe UI" FontSize="11"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" Margin="6,3,20,3"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{DynamicResource XpFaceDark}" BorderBrush="{DynamicResource PsAccent}"
                                        BorderThickness="1" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PsAccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource PsContentBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource XpBorder}"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PsAccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PsHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource PsContentBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource XpBorder}"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <GridViewRowPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PsAccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PsHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource XpFaceDark}"/>
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="BorderBrush" Value="{DynamicResource XpBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="Background" Value="{DynamicResource PsContentBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Fully retemplated rather than just recoloured. Left to its defaults a TreeViewItem
             paints its selected row with the *system* highlight colour and system highlight text -
             neither of which follows the app theme, so the topic selected when Help first opens
             came up as an unreadable combination (in the dark theme, dark system text on a pale
             system highlight). Selection now uses the same accent tint every other list here does. -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="Expander" Focusable="False" ClickMode="Press"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Width="16" Height="16">
                                            <Path x:Name="Arrow" Width="6" Height="8" Stretch="Fill"
                                                  Data="M0,0 L6,4 L0,8 Z" Fill="{DynamicResource PsTextDim}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Border x:Name="Bd" Grid.Column="1" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                   TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PsHover}"/>
                            </Trigger>
                            <!-- Last, so it wins over hover: a selected row keeps the accent tint
                                 with ordinary body text on top, readable in either theme. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PsAccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource XpFace}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource XpBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent"/>
                            <Border Grid.Row="1" Background="{DynamicResource XpFace}" BorderBrush="{DynamicResource XpBorder}" BorderThickness="1">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{DynamicResource XpFaceDark}" BorderBrush="{DynamicResource XpBorder}"
                                BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}" Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource XpFace}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PsAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource XpFaceDark}"
                                    BorderBrush="{DynamicResource XpBorder}" BorderThickness="1" Margin="0,8,0,0"/>
                            <Border Grid.Row="0" Background="{DynamicResource XpFace}" BorderBrush="{DynamicResource XpBorder}"
                                    BorderThickness="1" Padding="4,1" HorizontalAlignment="Left" Margin="8,0,0,0">
                                <ContentPresenter ContentSource="Header" TextElement.Foreground="{DynamicResource PsText}" TextElement.FontSize="10"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="10"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Collapsible section used by the Edit Colors "Standards" tab. -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton x:Name="Toggle" DockPanel.Dock="Top" Focusable="False"
                                          Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Hdr" Background="{DynamicResource XpFaceDark}" BorderBrush="{DynamicResource XpBorder}"
                                                BorderThickness="1" Padding="6,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="0" Width="8" Height="8" Stretch="Uniform"
                                                      Data="M0,0 L8,0 L4,6 Z" Fill="{DynamicResource PsText}" VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="-90"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                                                   TextElement.Foreground="{DynamicResource PsText}"
                                                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Hdr" Property="BorderBrush" Value="{DynamicResource PsAccent}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="ContentBd" DockPanel.Dock="Top" Background="{DynamicResource XpFace}"
                                    BorderBrush="{DynamicResource XpBorder}" BorderThickness="1,0,1,1" Visibility="Collapsed">
                                <ContentPresenter Margin="6"/>
                            </Border>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentBd" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal flat scrollbar (thumb-only, no arrow buttons), matching the thin dark
             scrollbars used throughout modern creative-tool dark themes. -->
        <Style x:Key="PsScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource XpBorderLight}" CornerRadius="2" Margin="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource XpFaceDark}"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PsScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="MinHeight" Value="12"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource PsScrollBarThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===================================================================
             App-specific named styles
             =================================================================== -->

        <!-- Flat "well" used for the toolbox / dock panels / status areas. -->
        <Style x:Key="SunkenPanel" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource XpBorder}"/>
            <Setter Property="Background" Value="{DynamicResource XpFace}"/>
        </Style>

        <!-- Small-caps section header used above the Swatches / Layers / History dock panels. -->
        <Style x:Key="DockHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource XpMenuBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource XpBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style x:Key="DockHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PsTextDim}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Icon-only tool-strip button (left toolbox). -->
        <Style x:Key="ToolButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <!-- No icon "chip" behind the glyph any more: the icons are monochrome
                             vectors drawn in the theme's own PsIconGlyph colour (see
                             Services/ToolIcons), so they sit legibly straight on the tool strip in
                             either theme. The chip previously here existed only to give the old
                             colour flat-art PNGs the light backdrop they'd been drawn against. -->
                        <Border x:Name="Bd" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PsAccent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PsAccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource XpBorderLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Layer visibility toggle: a bare slot for the eye glyph, with no button chrome of its
             own - the eye (or its absence) is the whole control, as in Photoshop's layers panel. -->
        <Style x:Key="LayerEyeStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover tint is what tells you the empty slot of a hidden layer is
                                 still a control you can click, with nothing drawn in it. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PsHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small toggle buttons used in the options bar (size / fill / shape pickers). -->
        <Style x:Key="OptionToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource PsText}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" BorderThickness="1" BorderBrush="{DynamicResource XpBorder}" Background="{DynamicResource XpFaceDark}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PsAccent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PsAccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PsAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DrawingBrush x:Key="CheckerboardBrush" Viewport="0,0,8,8" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="White">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,8,8"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#CCCCCC">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,4,4"/>
                                <RectangleGeometry Rect="4,4,4,4"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        </ResourceDictionary>
    </Application.Resources>
</Application>
