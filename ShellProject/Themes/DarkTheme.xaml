<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================================
         Dark theme (Photoshop-style). Historical key names (Xp*) are kept so
         every dialog that references {DynamicResource XpFace} etc. re-themes
         for free just by swapping which of these two dictionaries is merged
         into Application.Resources - see Services/ThemeManager.cs.
         =================================================================== -->
    <SolidColorBrush x:Key="XpFace" Color="#3A3A3A"/>            <!-- panel face -->
    <SolidColorBrush x:Key="XpFaceDark" Color="#262626"/>        <!-- sunken / content well face -->
    <SolidColorBrush x:Key="XpBorder" Color="#1A1A1A"/>          <!-- dark separators -->
    <SolidColorBrush x:Key="XpBorderLight" Color="#545454"/>     <!-- subtle raised-edge highlight -->
    <SolidColorBrush x:Key="XpBorderDarkShadow" Color="#2F7CD6"/><!-- pressed / checked accent border -->
    <SolidColorBrush x:Key="XpMenuBg" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="XpSelection" Color="#2F7CD6"/>
    <SolidColorBrush x:Key="XpTitleStart" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="XpTitleEnd" Color="#3A3A3A"/>

    <!-- Photoshop-ish tokens -->
    <SolidColorBrush x:Key="PsAccent" Color="#2F7CD6"/>
    <SolidColorBrush x:Key="PsAccentSoft" Color="#1F3A57"/>
    <SolidColorBrush x:Key="PsText" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="PsTextDim" Color="#ABABAB"/>
    <SolidColorBrush x:Key="PsCanvasSurround" Color="#4B4B4B"/>
    <SolidColorBrush x:Key="PsContentBg" Color="#202020"/>       <!-- list/content wells -->
    <SolidColorBrush x:Key="PsHover" Color="#454545"/>
    <!-- Toolbox glyph colour (Services/ToolIcons). Light on the dark tool strip, and light enough
         to stay legible on the accent-tinted background a selected tool button gets. -->
    <SolidColorBrush x:Key="PsIconGlyph" Color="#D6D6D6"/>

</ResourceDictionary>
