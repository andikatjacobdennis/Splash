<Window x:Class="PaintClone.Dialogs.EditColorsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Colors" Height="580" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow"
        Icon="pack://application:,,,/Resources/Mascot/mascot.ico"
        FontFamily="Tahoma" FontSize="11" Background="{StaticResource XpFace}"
        ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Left: tabbed swatch sources -->
        <TabControl Grid.Column="0" Grid.Row="0">
            <TabItem Header="Basic">
                <StackPanel Margin="4">
                    <UniformGrid x:Name="BasicGrid" Columns="7"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Material">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                    <TextBlock Text="Material Design colors:" FontSize="9" Margin="0,0,0,4"/>
                    <UniformGrid x:Name="MaterialGrid" Columns="5" Margin="0,0,0,8"/>
                    <TextBlock x:Name="MaterialShadeLabel" Text="Shades:" FontSize="9" Margin="0,0,0,4" Visibility="Collapsed"/>
                    <WrapPanel x:Name="MaterialShadeRow"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Flat UI">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">
                        <TextBlock Text="Flat UI palette:" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                        <UniformGrid x:Name="FlatUIGrid" Columns="5" Margin="0,0,0,10"/>
                        <TextBlock Text="Extended flat tones:" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                        <UniformGrid x:Name="FlatUIExtendedGrid" Columns="5"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Standards">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="StandardsPanel" Margin="4"/>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Custom">
                <StackPanel Margin="4">
                    <TextBlock Text="Custom colors - 30 slots (right-click to remove):" FontSize="9" Margin="0,0,0,4"/>
                    <UniformGrid x:Name="CustomGrid" Columns="10" Rows="3" Height="84" Margin="0,0,0,8"/>
                    <Button Content="Add to Custom Colors" Margin="0,0,0,10" Click="AddCustom_Click"/>
                    <TextBlock Text="Recently used:" FontSize="9" Margin="0,0,0,4"/>
                    <UniformGrid x:Name="RecentGrid" Columns="7" Height="60"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Right: spectrum picker, preview, and numeric fields -->
        <StackPanel Grid.Column="2" Grid.Row="0">
            <TextBlock Text="Pick a color:" FontWeight="Bold" Margin="0,0,0,6"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <!-- Saturation/Luminosity square, at the currently chosen hue -->
                <Canvas x:Name="SLCanvas" Width="150" Height="150" ClipToBounds="True"
                        MouseLeftButtonDown="SLCanvas_MouseDown" MouseMove="SLCanvas_MouseMove"
                        MouseLeftButtonUp="Picker_MouseUp" Cursor="Cross">
                    <Image x:Name="SLImage" Width="150" Height="150"/>
                    <Border x:Name="SLMarker" Width="10" Height="10" CornerRadius="5"
                            BorderBrush="Black" BorderThickness="1.5" IsHitTestVisible="False"/>
                </Canvas>

                <Canvas x:Name="HueCanvas" Width="26" Height="150" Margin="8,0,0,0" ClipToBounds="True"
                        MouseLeftButtonDown="HueCanvas_MouseDown" MouseMove="HueCanvas_MouseMove"
                        MouseLeftButtonUp="Picker_MouseUp" Cursor="Hand">
                    <Image x:Name="HueImage" Width="26" Height="150"/>
                    <Rectangle x:Name="HueMarker" Width="26" Height="3" Fill="Black" IsHitTestVisible="False"/>
                </Canvas>

                <StackPanel Margin="12,0,0,0" VerticalAlignment="Top">
                    <TextBlock Text="Current / New:" FontSize="9" Margin="0,0,0,2"/>
                    <Border BorderBrush="{StaticResource XpBorderDarkShadow}" BorderThickness="2" Width="70" Height="46">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border x:Name="CurrentSwatch" Grid.Row="0"/>
                            <Border x:Name="PreviewSwatch" Grid.Row="1"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Red:" VerticalAlignment="Center"/>
                        <TextBox x:Name="RBox" Grid.Column="1" Text="0" TextChanged="RgbChannel_Changed"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Green:" VerticalAlignment="Center"/>
                        <TextBox x:Name="GBox" Grid.Column="1" Text="0" TextChanged="RgbChannel_Changed"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Blue:" VerticalAlignment="Center"/>
                        <TextBox x:Name="BBox" Grid.Column="1" Text="0" TextChanged="RgbChannel_Changed"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="H:" VerticalAlignment="Center"/>
                        <TextBox x:Name="HBox" Grid.Column="1" Text="0" TextChanged="HslField_Changed"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="S:" VerticalAlignment="Center"/>
                        <TextBox x:Name="SBox" Grid.Column="1" Text="0" TextChanged="HslField_Changed"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="L:" VerticalAlignment="Center"/>
                        <TextBox x:Name="LBox" Grid.Column="1" Text="0" TextChanged="HslField_Changed"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <TextBlock Text="Opacity:" FontSize="9" Margin="0,8,0,2"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="AlphaSlider" Minimum="0" Maximum="255" Value="255"
                        VerticalAlignment="Center" ValueChanged="AlphaSlider_Changed"
                        ToolTip="0 is fully transparent, 255 fully opaque"/>
                <TextBox x:Name="AlphaBox" Grid.Column="1" Text="255" TextChanged="AlphaBox_Changed" Margin="4,0,0,0"/>
            </Grid>

            <TextBlock Text="Hex:" FontSize="9" Margin="0,8,0,2"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="HexBox" Text="#000000" TextChanged="HexBox_Changed" Width="90" HorizontalAlignment="Left"/>
                <Button Content="Copy" Margin="6,0,0,0" Padding="6,2" Click="CopyHex_Click" ToolTip="Copy hex code to clipboard"/>
            </StackPanel>

            <TextBlock Text="Quick actions:" FontSize="9" Margin="0,8,0,2"/>
            <WrapPanel>
                <Button Content="Grayscale" Margin="0,0,4,4" Padding="6,2" Click="Grayscale_Click"/>
                <Button Content="Invert" Margin="0,0,4,4" Padding="6,2" Click="Invert_Click"/>
                <Button Content="Complementary" Margin="0,0,4,4" Padding="6,2" Click="Complementary_Click"/>
                <Button Content="Random" Margin="0,0,4,4" Padding="6,2" Click="Random_Click"/>
                <Button Content="Transparent" Margin="0,0,4,4" Padding="6,2" Click="Transparent_Click"/>
            </WrapPanel>

            <TextBlock Text="Shades:" FontSize="9" Margin="0,6,0,2"/>
            <StackPanel x:Name="ShadesPanel" Orientation="Horizontal"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="75" Margin="0,0,6,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="75" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
