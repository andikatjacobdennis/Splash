<Window x:Class="PaintClone.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Splash" Height="380" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow"
        Icon="pack://application:,,,/Resources/Mascot/mascot.ico"
        FontFamily="Segoe UI" FontSize="11" Background="{DynamicResource XpFace}"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Mascot -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Top">
            <Image x:Name="MascotImage" Width="90" Height="90" Cursor="Hand"
                   MouseLeftButtonDown="Mascot_Click" ToolTip="Go on, poke him">
                <Image.RenderTransform>
                    <RotateTransform x:Name="MascotRotate" CenterX="45" CenterY="45"/>
                </Image.RenderTransform>
            </Image>
            <Border x:Name="SpeechBubble" Background="White" BorderBrush="#1B2A4A" BorderThickness="1.5"
                    CornerRadius="6" Padding="6,4" Margin="0,4,0,0" Visibility="Collapsed" MaxWidth="120">
                <TextBlock x:Name="SpeechText" TextWrapping="Wrap" FontSize="9" TextAlignment="Center"/>
            </Border>
            <TextBlock x:Name="MascotNameText" HorizontalAlignment="Center" FontSize="9" FontStyle="Italic" Foreground="{DynamicResource PsTextDim}" Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1">
            <TextBlock Text="Splash" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PsAccent}" Margin="0,0,0,2"/>
            <TextBlock x:Name="TaglineText" FontSize="11" Foreground="{DynamicResource PsTextDim}" Margin="0,0,0,8" TextWrapping="Wrap"/>

            <Border Background="White" BorderBrush="{DynamicResource XpBorder}" BorderThickness="1" Padding="8,6" Margin="0,0,0,10">
                <TextBlock x:Name="FunFactText" FontStyle="Italic" TextWrapping="Wrap" FontSize="10" Foreground="#333"/>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Version:" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBlock x:Name="VersionText" Grid.Row="0" Grid.Column="1" Margin="0,0,0,3"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Runtime:" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBlock x:Name="RuntimeText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,3"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Built with:" FontWeight="Bold"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="C# / WPF / .NET"/>
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" FontSize="9" Foreground="{DynamicResource PsTextDim}"
                   Margin="0,14,0,0"
                   Text="This is an independent, unofficial project inspired by classic early-2000s paint programs. It is not affiliated with, endorsed by, or a product of any software vendor."/>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="AnotherFactBtn" Content="Another fact!" Padding="8,3" Margin="0,0,8,0" Click="AnotherFact_Click"/>
            <Button Content="OK" Width="75" Height="23" IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
