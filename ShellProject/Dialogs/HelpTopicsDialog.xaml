<Window x:Class="PaintClone.Dialogs.HelpTopicsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paint Help" Height="480" Width="620"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow"
        Icon="pack://application:,,,/Resources/Mascot/mascot.ico"
        FontFamily="Tahoma" FontSize="11" Background="{StaticResource XpFace}"
        ShowInTaskbar="False">
    <DockPanel>

        <Button DockPanel.Dock="Bottom" Content="Close" Width="75" Height="23" HorizontalAlignment="Right"
                Margin="10" IsDefault="True" IsCancel="True"/>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Contents" FontWeight="Bold" Margin="2,0,0,4"/>
                <Border BorderBrush="{StaticResource XpBorder}" BorderThickness="1" Background="White">
                    <TreeView x:Name="ContentsTree" BorderThickness="0" SelectedItemChanged="ContentsTree_SelectedItemChanged"/>
                </Border>
            </DockPanel>

            <Border Grid.Column="2" BorderBrush="{StaticResource XpBorder}" BorderThickness="1" Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                    <StackPanel>
                        <TextBlock x:Name="TopicTitleText" FontSize="14" FontWeight="Bold" Foreground="#0A246A" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TopicContent" TextWrapping="Wrap" LineHeight="17"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
