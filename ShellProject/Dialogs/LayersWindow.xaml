<Window x:Class="PaintClone.Dialogs.LayersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Layers" Height="360" Width="220"
        WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/Resources/Mascot/mascot.ico"
        FontFamily="Tahoma" FontSize="11" Background="{StaticResource XpFace}"
        ShowInTaskbar="False">
    <DockPanel Margin="6">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
            <Button x:Name="AddBtn" Content="Add" Width="42" Margin="0,0,3,0" Click="AddLayer_Click" ToolTip="Add a new layer"/>
            <Button x:Name="DeleteBtn" Content="Del" Width="36" Margin="0,0,3,0" Click="DeleteLayer_Click" ToolTip="Delete the active layer"/>
            <Button x:Name="UpBtn" Content="▲" Width="28" Margin="0,0,3,0" Click="MoveUp_Click" ToolTip="Move layer up"/>
            <Button x:Name="DownBtn" Content="▼" Width="28" Margin="0,0,3,0" Click="MoveDown_Click" ToolTip="Move layer down"/>
            <Button x:Name="MergeBtn" Content="Merge" Width="46" Click="MergeDown_Click" ToolTip="Merge down into the layer below"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="Click a layer to make it active. Checkbox toggles visibility." FontSize="9" Margin="2,0,0,4" TextWrapping="Wrap"/>
        <Border BorderBrush="{StaticResource XpBorder}" BorderThickness="1" Background="White">
            <ListBox x:Name="LayersList" BorderThickness="0"/>
        </Border>
    </DockPanel>
</Window>
