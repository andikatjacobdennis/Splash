<Window x:Class="PaintClone.Dialogs.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History" Height="420" Width="240"
        WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/Resources/Mascot/mascot.ico"
        FontFamily="Tahoma" FontSize="11" Background="{StaticResource XpFace}"
        ShowInTaskbar="False">
    <DockPanel Margin="6">
        <TextBlock DockPanel.Dock="Top" Text="Click a step to jump to it. Right-click to delete it." FontSize="9" Margin="2,0,0,4" TextWrapping="Wrap"/>
        <TextBlock DockPanel.Dock="Bottom" Text="Steps can be deleted but not reordered - each one depends on the exact sequence that produced it." FontSize="8" Foreground="#666" Margin="2,4,0,0" TextWrapping="Wrap"/>
        <Border BorderBrush="{StaticResource XpBorder}" BorderThickness="1" Background="White">
            <ListBox x:Name="HistoryList" BorderThickness="0" SelectionChanged="HistoryList_SelectionChanged"
                     MouseRightButtonDown="HistoryList_MouseRightButtonDown"/>
        </Border>
    </DockPanel>
</Window>
