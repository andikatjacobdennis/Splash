<Window x:Class="PaintClone.Dialogs.NewDocumentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Picture" Height="420" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow"
        Icon="pack://application:,,,/Resources/Mascot/mascot.ico"
        FontFamily="Segoe UI" FontSize="11" Background="{DynamicResource XpFace}"
        ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource XpBorder}" BorderThickness="1" Background="{DynamicResource PsContentBg}" Margin="0,0,0,8">
            <ListBox x:Name="PresetList" BorderThickness="0" SelectionChanged="PresetList_SelectionChanged"/>
        </Border>

        <GroupBox Grid.Row="1" Header="Custom size" Margin="0,0,0,8">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="6"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Width:" VerticalAlignment="Center"/>
                <TextBox x:Name="WidthBox" Grid.Row="0" Grid.Column="1" Text="480" TextChanged="CustomSize_Changed"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="x" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Height:" VerticalAlignment="Center"/>
                <TextBox x:Name="HeightBox" Grid.Row="0" Grid.Column="4" Text="360" TextChanged="CustomSize_Changed"/>

                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Content="Save as preset..." Click="SavePreset_Click" HorizontalAlignment="Left" Padding="6,2"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="75" Margin="0,0,6,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="75" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
